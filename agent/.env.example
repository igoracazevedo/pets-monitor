# Supabase (Settings > API). A chave de SERVIÇO ignora o RLS: fica só neste computador, nunca no site.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=coloque-aqui-a-service-role-key

# URLs das câmeras (usadas no config.yaml com ${NOME})
CAM_SALA_URL=rtsp://usuario:senha@192.168.1.50:554/stream1
CAM_COZINHA_URL=rtsp://usuario:senha@192.168.1.51:554/stream1

# NVR (use com fonte: nvr no config.yaml)
NVR_IP=192.168.1.100
NVR_USUARIO=admin
NVR_SENHA=troque-aqui
NVR_PORTA=554
